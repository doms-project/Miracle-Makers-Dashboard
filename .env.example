# ---------------------------------------------------------------------------
# Miracle Makers OLTL Dashboard — environment variables
#
# Copy this file to `.env.local` for local development, and set the same
# variables in the Vercel dashboard (Project → Settings → Environment Variables)
# for production. NEVER commit real values — the token must not touch the repo
# or the browser. It is only ever read server-side inside /api/opportunities.
# ---------------------------------------------------------------------------

# REQUIRED — GoHighLevel Private Integration Token (looks like `pit-...`).
# Sent as `Authorization: Bearer <token>` (verified against the v2 API).
GHL_PIT=

# REQUIRED for SSO (Phase 3) — the marketplace app's Shared Secret (SSO key),
# from the app → MANAGE → Secrets in the GHL marketplace. Used SERVER-SIDE only
# to decrypt the SSO blob in /api/decrypt-sso. Never exposed to the browser.
GHL_SSO_SECRET=

# REQUIRED — the GHL sub-account (location) ID. ⭐ v2 NEW ACCOUNT.
GHL_LOCATION_ID=anzcWt3S0tzpu2fEaS8X

# OPTIONAL — the same location id exposed to the browser, used ONLY to build
# GHL deep-link URLs (e.g. a caregiver contact link). Not secret. Defaults to
# the v2 account if unset.
NEXT_PUBLIC_GHL_LOCATION_ID=anzcWt3S0tzpu2fEaS8X

# ⬜ RE-DERIVE for the new account — the OLTL Resources media folder ID.
# The value below is the OLD account's folder and will NOT exist here; run
# scripts/rederive-ids-probe.mjs and replace it (the tab shows only files whose
# parentId equals this folder, so the shared Media Library never leaks in).
RESOURCES_FOLDER_ID=6a75ea609994d35aa0c66e9a

# OPTIONAL — the pipelines the dashboard spans (v2 multi-pipeline).
# Comma / pipe / whitespace separated pipeline IDs, in the order they should
# appear. If left blank, defaults to the five confirmed for this account:
#   OLTL Enrollment, OLTL Transfer, ODP Enrollment, ODP Transfer, Private Pay Clients.
# (Replaces the retired OLTL_PIPELINE_ID + the /oltl/i name fallback.)
PIPELINE_IDS=KGjdCMG4F8xILk0ineB9,74Pt3XX4hgBIqD10mW4G,a14NtTi18ACxs99bHPmL,PIs1iWVk0HqHZFNtmoTn,BJBWdRim6SOgjoMelVSZ

# OPTIONAL — pipeline access map (division scoping). Maps a GHL user id to the
# HOME pipeline(s) of their division. Format: "userId:pid|pid,userId:pid|pid".
# A user not listed here is ungranted — they browse nothing, but still see any
# record they own or follow (flagged "shared"). Admins see all. Fails closed.
# Interim source; the durable answer is a custom field on the GHL user record —
# getUserHomePipelines() is the single swap point. Roster (Dom = placeholder):
#   Jackie On2hTvaKMQ1ktEYcNs32 Private Pay ; Bill tR8rV1dcVfs3Z0wH5Ogg ODP ;
#   Lamarr 2635GTUGcn7XLPeSa3as OLTL ; Chris w90ItEk0IDeSeTL7hAYJ OLTL-CHC
PIPELINE_ACCESS_MAP=On2hTvaKMQ1ktEYcNs32:BJBWdRim6SOgjoMelVSZ,tR8rV1dcVfs3Z0wH5Ogg:a14NtTi18ACxs99bHPmL|PIs1iWVk0HqHZFNtmoTn,2635GTUGcn7XLPeSa3as:KGjdCMG4F8xILk0ineB9|74Pt3XX4hgBIqD10mW4G,w90ItEk0IDeSeTL7hAYJ:KGjdCMG4F8xILk0ineB9|74Pt3XX4hgBIqD10mW4G

# ⬜ RE-DERIVE for the new account — the caregiver↔client association ID.
# The value below is the OLD account's association and will NOT exist here. Run
# scripts/rederive-ids-probe.mjs; if none is returned it must be CREATED
# (POST /associations, key "caregiver_client") — the probe prints the payload.
CAREGIVER_ASSOCIATION_ID=6a6e26c9884def7a1438b965

# ⚠️ PIPELINE_ACCESS_MAP above uses OLD-account user IDs — they will not match
# users in anzcWt3S0tzpu2fEaS8X. Run the probe (it lists this account's users +
# warns on unmatched ids) and replace them, or every non-admin will (fail-closed)
# see only what they own/follow.

# OPTIONAL — GHL API version header. Defaults to 2021-07-28 if unset.
GHL_API_VERSION=2021-07-28

# OPTIONAL (Task 5 email) — Version header for the email templates + outbound
# send endpoints. GHL documents these against 2021-04-15; override if the tenant
# accepts a different one (confirm with scripts/email-templates-probe.mjs).
GHL_EMAIL_API_VERSION=2021-04-15

# OPTIONAL (Task 5 email) — verified sending address for outbound email. Must
# belong to the authenticated Miracle Makers domain. Leave blank until the
# domain is authenticated (Jack/DNS); when blank, GHL uses the sub-account default.
GHL_EMAIL_FROM=

# OPTIONAL — auth scheme for the Authorization header.
# Defaults to "Bearer" (leave BLANK to use it) — verified working against the
# GHL v2 API. Set to "none" (or "raw") to send the bare token with no prefix,
# or to some other scheme string if a future endpoint needs one. No code change.
GHL_AUTH_SCHEME=

# ITEM 13 — the CAREGIVER pipelines, kept separate from PIPELINE_IDS so they
# can never appear in the client list, kanban or master view. Adding OLTL_CHC
# when its pipeline exists is one more id here — no code change.
CAREGIVER_PIPELINE_IDS=EXVMveGzgDy9qf4wQR2H,232bytrK7FWNAwC6shME

# ═══════════════════════════════════════════════════════════════════════════
# 🔴 CROSS-ACCOUNT TRANSFER (round 132) — THE OTHER COMPANY'S SUB-ACCOUNT
# ═══════════════════════════════════════════════════════════════════════════
#
# The ODP division was sold. Two companies, two GoHighLevel sub-accounts, two
# deployments of this same codebase. A client or caregiver occasionally has to
# move between them — and because NOTHING is shared between sub-accounts, that
# is not a move: the record is recreated there and closed here.
#
# 🔴 WITHOUT ALL THREE OF THESE THERE IS NO TRANSFER BUTTON AT ALL.
#
# That is deliberate — a button that is always present and always answers "this
# deployment has no link to the other account" teaches people to ignore buttons
# — but it means somebody setting up a THIRD account will find the feature
# simply missing, with nothing on screen to say why. This block is that
# explanation. The payload carries `peer: { configured, label }`; the token
# itself never leaves the server.
#
# ⚠️ THE VALUES ARE CROSSED. On the Miracle Makers deployment these name the
# ODP account; on the ODP deployment they name Miracle Makers. Each holds the
# OTHER one's. Getting this wrong points a deployment at itself, and the first
# transfer will refuse because the person already holds that case.
#
# ⚠️ AND THE ACCOUNTS NEED SETUP THIS CODE DOES NOT CREATE:
#   · a TRANSFERRED OUT destination on the SENDING side — a pipeline of that
#     name, or a stage of that name in each client pipeline. Append it; do not
#     recreate stages, or every existing stage id changes and every record moves.
#   · a TRANSFERRED IN stage on the RECEIVING side, in each pipeline that can
#     receive. A transfer lands there and nowhere else, and refuses if it is
#     absent rather than filing the case as a fresh enquiry.
#   · optionally a "Peer Record Id" OPPORTUNITY field on both. Without it the
#     transfer still completes and the other side's id goes in the note only;
#     the step list says so rather than failing.
#
# REQUIRED FOR TRANSFERS — the OTHER account's Private Integration Token.
# Server-side only, exactly like GHL_PIT. (GHL_PIT and GHL_LOCATION_ID above
# already ARE this deployment's own pair — they are not renamed to PIT_SELF
# because that would touch 41 call sites to change nothing.)
PEER_PIT=

# REQUIRED FOR TRANSFERS — the OTHER account's location id.
PEER_LOCATION_ID=

# OPTIONAL but strongly recommended — what to CALL the other company on screen.
# Every sentence in the transfer dialog uses it: "Transfer Mary Malone to ODP
# Care", "ODP Care has not verified the work behind it". Defaults to the
# rather unhelpful "the other account" when unset.
PEER_LABEL=

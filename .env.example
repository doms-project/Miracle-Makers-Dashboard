# Environment variables.
# Copy this file to .env.local for local work and set the same values in Vercel
# (Project > Settings > Environment Variables). Never commit real values.

# GoHighLevel token and location (server side only).
GHL_PIT=
GHL_LOCATION_ID=
# Same location id, exposed to the browser only to build GHL links. Not secret.
NEXT_PUBLIC_GHL_LOCATION_ID=

# Marketplace app shared secret, used to decrypt the SSO session.
GHL_SSO_SECRET=
# Set to 1 to log decrypted SSO sessions. Debug only, leave empty otherwise.
SSO_PROBE=

# Pipelines, access and labels.
# Client pipeline ids (comma separated, in display order).
PIPELINE_IDS=
# Caregiver pipeline ids (kept out of the client views).
CAREGIVER_PIPELINE_IDS=
# Division access: userId:pipelineId|pipelineId,userId:pipelineId
PIPELINE_ACCESS_MAP=
# Private Pay pipeline id, used for its badge in the browser.
NEXT_PUBLIC_PRIVATE_PAY_PIPELINE_ID=
# Cases created on or after this date get the "new lead" label.
NEW_LEAD_SINCE=

# Caregivers and resources.
# Caregiver to client association id.
CAREGIVER_ASSOCIATION_ID=
# Resources media folder id.
RESOURCES_FOLDER_ID=
# One resources folder that everyone can see.
RESOURCES_PUBLIC_FOLDER_ID=

# Email sending.
GHL_EMAIL_FROM=
GHL_EMAIL_API_VERSION=

# Webhooks (inbound and outbound).
WEBHOOK_SECRET=
# Receiver for outbound events. Empty means off.
WEBHOOK_URL=

# Transfers to the other account. All three are needed for the transfer button.
PEER_PIT=
PEER_LOCATION_ID=
PEER_LABEL=

# API overrides. Defaults work, leave empty unless needed.
GHL_API_BASE=
GHL_API_VERSION=
GHL_AUTH_SCHEME=

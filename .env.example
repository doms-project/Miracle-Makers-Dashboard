# ---------------------------------------------------------------------------
# Miracle Makers OLTL Dashboard — environment variables
#
# Copy this file to `.env.local` for local development, and set the same
# variables in the Vercel dashboard (Project → Settings → Environment Variables)
# for production. NEVER commit real values — the token must not touch the repo
# or the browser. It is only ever read server-side inside /api/opportunities.
# ---------------------------------------------------------------------------

# REQUIRED — GoHighLevel Private Integration Token.
# Sent to GHL as a raw `Authorization` header (NO "Bearer" prefix).
GHL_PIT=

# REQUIRED — the GHL sub-account (location) ID.
GHL_LOCATION_ID=YVPhIAECw9q1M9Jw6A8L

# OPTIONAL — the OLTL Enrollments pipeline ID.
# If left blank, the API route looks the pipeline up by name (matches /oltl/i)
# among the location's pipelines. Set this once you have the exact ID to skip
# the lookup and remove any ambiguity.
OLTL_PIPELINE_ID=

# OPTIONAL — GHL API version header. Defaults to 2021-07-28 if unset.
GHL_API_VERSION=2021-07-28
